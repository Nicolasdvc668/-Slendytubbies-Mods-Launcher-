• ✅ Gerenciador de mods com ativar/desativar
• ✅ Seletor de versões do jogo
• ✅ Aviso de atualizações
• ✅ Links da comunidade

Feito com ❤️ para a comunidade de fãs!
        """
        
        ctk.CTkLabel(frame, text=info, justify="center", font=ctk.CTkFont(size=12)).pack(pady=10)
        
        ctk.CTkButton(
            frame, text="🌐 Visitar Site Oficial do Jogo",
            command=lambda: webbrowser.open(SITE_OFICIAL)
        ).pack(pady=10)

    # ==================================================
    # EXECUTAR
    # ==================================================
    def rodar(self):
        self.janela.mainloop()

# ==================================================
# INICIAR
# ==================================================
if __name__ == "__main__":
    app = LauncherSlendytubbies()
    app.rodar()
